# Copie para ~/.config/spkids/env e ajuste. NUNCA versione o arquivo real.
#   mkdir -p ~/.config/spkids && cp env.exemplo ~/.config/spkids/env
#   chmod 600 ~/.config/spkids/env

# Para onde vai o alerta.
SPKIDS_ALERTA_PARA=voce@gmail.com

# No Gmail e obrigatorio uma SENHA DE APP (16 caracteres), gerada em
# https://myaccount.google.com/apppasswords — exige verificacao em 2 etapas.
# A senha normal da conta nao funciona em SMTP desde 2022.
SPKIDS_SMTP_HOST=smtp.gmail.com
SPKIDS_SMTP_PORTA=587
SPKIDS_SMTP_USUARIO=voce@gmail.com
SPKIDS_SMTP_SENHA=COLE_AQUI_A_SENHA_DE_APP

# Conta na SP Kids: so e usada pela compra automatica (e por --testar-login).
# SPKIDS_EMAIL=voce@empresa.com.br
# SPKIDS_SENHA='sua-senha'   # aspas simples se tiver $, & ou %

# Compra automatica: assim que o produto ID tiver estoque, poe QTD no carrinho
# da conta, fecha o pedido com Pix e manda o link por e-mail. Compra uma vez so.
# Os dados de cobranca/entrega sao os que estao salvos na conta.
# SPKIDS_COMPRA=2003:3        # 2003 = Treinador Avancado (ETB), 3 caixas
# SPKIDS_FRETE=Retirada       # trecho do nome do frete no checkout
