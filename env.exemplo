# So para rodar o resumo de noticias desta maquina (no dia a dia ele roda no
# GitHub Actions, com estes mesmos nomes como segredos do repositorio).
# NUNCA versione o arquivo real.
#   mkdir -p ~/.config/spkids && cp env.exemplo ~/.config/spkids/env
#   chmod 600 ~/.config/spkids/env
#   set -a; . ~/.config/spkids/env; set +a; python3 resumo_noticias.py

# Para onde vai o resumo (varios: separados por virgula).
RESUMO_PARA=voce@gmail.com

# No Gmail e obrigatorio uma SENHA DE APP (16 caracteres), gerada em
# https://myaccount.google.com/apppasswords — exige verificacao em 2 etapas.
SMTP_HOST=smtp.gmail.com
SMTP_PORTA=587
SMTP_USUARIO=voce@gmail.com
SMTP_SENHA=COLE_AQUI_A_SENHA_DE_APP
