#!/usr/bin/env bash
# Trunk-based: o unico destino de push e a main. Branch nova no remoto e
# recusada; apagar branch remota (limpeza) e permitido.
set -euo pipefail

zeros="0000000000000000000000000000000000000000"
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zeros" ] && continue  # apagando no remoto
  if [ "$remote_ref" != "refs/heads/main" ]; then
    echo "push recusado: $remote_ref. Aqui tudo vai direto para a main (sem branch, sem PR)." >&2
    exit 1
  fi
done
